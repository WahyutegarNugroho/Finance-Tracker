{
  "name": "finance-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "workspaces": [
    "apps/*"
  ],
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=3": "5.0.9",
      "js-yaml": "4.3.1",
      "postcss": "8.5.26",
      "nanoid": "3.3.18",
      "ip-address": "10.5.0",
      "sharp": "0.35.3",
      "shell-quote": "1.10.0"
    }
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "seed": "npm run seed --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "lint:api": "npm run lint --workspace=apps/api",
    "lint:web": "npm run lint --workspace=apps/web",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
